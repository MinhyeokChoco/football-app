{
  "name": "football-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "emulators": "firebase emulators:start --project demo-football",
    "dev": "firebase emulators:exec --project demo-football --ui \"ng serve\"",
    "test:rules": "firebase emulators:exec --only firestore --project demo-football-rules \"vitest run --config rules-tests/vitest.config.mts\"",
    "deploy": "ng build && firebase deploy --only hosting,firestore"
  },
  "private": true,
  "packageManager": "npm@11.21.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.0",
    "firebase": "^13.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase-tools": "^15.34.1",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
